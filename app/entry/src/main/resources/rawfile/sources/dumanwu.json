{
  "id": "dumanwu",
  "name": "读漫屋",
  "baseUrl": "http://dumanwu1.com",
  "charset": "utf-8",
  "note": "搜索走 POST /s 返回 JSON；详情/目录纯 HTML；正文图由页面脚本解密，走无头取图",
  "headers": [
    { "name": "Referer", "value": "http://dumanwu1.com/" }
  ],
  "search": {
    "url": "/s",
    "method": "post",
    "body": "k={kw}",
    "responseType": "json",
    "jsonPath": "$.data",
    "jsonIdField": "id",
    "jsonTitleField": "name",
    "jsonCoverField": "imgurl",
    "jsonLatestField": "remarks",
    "jsonLinkTemplate": "/{id}/",
    "list": "",
    "title": "",
    "cover": "",
    "link": "",
    "author": "",
    "latest": ""
  },
  "detail": {
    "title": "h1.banner-title@text",
    "cover": "img.banner-pic@attr:data-src||img.banner-pic@attr:src",
    "author": "",
    "desc": "p.introduction@text",
    "status": "",
    "tags": ""
  },
  "chapters": {
    "list": "div.chaplist-box li",
    "id": "",
    "title": "a@text",
    "link": "a@attr:href",
    "reverse": false
  },
  "images": {
    "type": "web",
    "url": "{chapterUrl}",
    "readySelector": "div.chapter-img-box img",
    "extract": "attr:data-src",
    "settleMs": 3500
  },
  "browse": [
    {
      "name": "精品榜",
      "url": "/rank/1",
      "list": "ol.rank-list li",
      "title": "h2@text",
      "cover": "img.cartoon-poster@attr:data-src",
      "link": "a@attr:href",
      "author": "div.simple-info p@text",
      "latest": "div.simple-info p:last-child@text"
    },
    {
      "name": "人气榜",
      "url": "/rank/2",
      "list": "ol.rank-list li",
      "title": "h2@text",
      "cover": "img.cartoon-poster@attr:data-src",
      "link": "a@attr:href",
      "author": "div.simple-info p@text",
      "latest": "div.simple-info p:last-child@text"
    },
    {
      "name": "推荐榜",
      "url": "/rank/3",
      "list": "ol.rank-list li",
      "title": "h2@text",
      "cover": "img.cartoon-poster@attr:data-src",
      "link": "a@attr:href",
      "author": "div.simple-info p@text",
      "latest": "div.simple-info p:last-child@text"
    },
    {
      "name": "最近更新",
      "url": "/rank/5",
      "list": "ol.rank-list li",
      "title": "h2@text",
      "cover": "img.cartoon-poster@attr:data-src",
      "link": "a@attr:href",
      "author": "div.simple-info p@text",
      "latest": "div.simple-info p:last-child@text"
    }
  ]
}
