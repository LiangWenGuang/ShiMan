{
  "id": "manwa",
  "name": "漫蛙",
  "baseUrl": "https://manwawang.com",
  "charset": "utf-8",
  "note": "正文图 AES-CBC 加密（params 密文 + 密钥），与爱国漫/国漫网同密钥",
  "headers": [
    {
      "name": "Referer",
      "value": "https://manwawang.com/"
    },
    {
      "name": "User-Agent",
      "value": "Mozilla/5.0 (Linux; Android 6.0; Nexus 5 Build/MRA58N) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/132.0.0.0 Mobile Safari/537.36"
    }
  ],
  "search": {
    "url": "/search?key={kw}",
    "list": "div.manga-i-list-item",
    "id": "",
    "title": "p.manga-i-list-title@text",
    "cover": "img.manga-i-cover@attr:src",
    "link": "a@attr:href",
    "author": "",
    "latest": ""
  },
  "detail": {
    "title": "p.detail-main-title@text",
    "cover": "div.detail-bar-bg img@attr:src",
    "author": "p.detail-main-subtitle a span@text",
    "desc": "p.detail-main-content@text",
    "status": "",
    "tags": ""
  },
  "chapters": {
    "list": "div.detail-list-item a",
    "id": "",
    "title": "@text",
    "link": "@attr:href",
    "reverse": false
  },
  "images": {
    "type": "aes",
    "url": "{chapterUrl}",
    "aesKey": "9S8$vJnU2ANeSRoF",
    "aesPattern": "params = '(.*?)';",
    "aesIvSource": "cipher16",
    "aesListPattern": "\"images\":\\[(.*?)\\]"
  },
  "browse": [
    {
      "name": "全部漫画",
      "url": "/list/",
      "list": "div.manga-i-list-item",
      "title": "p.manga-i-list-title@text",
      "cover": "img.manga-i-cover@attr:src",
      "link": "a@attr:href"
    }
  ]
}
