# ── 构建产物 ──
app/.hvigor/
.hvigor/
app/entry/build/
app/build/
**/oh_modules/
**/node_modules/
**/.cxx/
local.properties
logs/
nul

# ── 签名材料：含证书路径与口令，绝不能提交 ──
signwork/
*.p7b
*.p12
*.cer
*.csr
*.keystore
app/build-profile.json5

# ── 打包产物：签名绑定设备 UDID，别人装了也跑不了 ──
hap/
*.hap
*.hsp
# 例外：发版目录里的安装包要跟仓库一起走，方便发给人下载
!releases/*.hap

# ── 已下架的图源规则（本地备份，不入库；需要时从 git 历史里找回来）──
app/entry/src/main/resources/rawfile/sources/_disabled/

# ── 开发期探测缓存 ──
tools/dumps/
tools/probe-*.json
tools/icon-preview-*.png
tools/*.log

# ── 调试截图 ──
/*.jpeg
/*.jpg
/*.png

# ── 系统与编辑器 ──
.DS_Store
Thumbs.db
.idea/
app/.idea/
*.iml
